# ═════════════════════════════════════════════════════════════════
# 血压计客服 Agent —— 环境变量模板
# 复制为 .env 并填入真实值：cp .env.example .env
# 安全约定：密钥只通过环境变量注入（.env 已被 .gitignore 忽略），代码零硬编码
# ═════════════════════════════════════════════════════════════════

# ── LLM 网关主链路（llm_gateway.py，两版 ReAct 统一入口） ──
# 主链路 API Key（DashScope OpenAI 兼容端点，base_url 代码内固定）
DASHSCOPE_API_KEY=your-api-key-here

# 主链路模型名（默认 qwen-max；备链路见下方 P4 区块）
AGENT_MODEL=qwen-max

# ── Embedding / Rerank ──────────────────────────────────────────
# local=本地 BGE（模型缺失自动降级 TF 向量）| dashscope=云端 text-embedding-v3
BP_EMBED_PROVIDER=local
# 本地 BGE embedding 模型目录（默认项目根下 bge-small-zh-v1.5）
BP_MODEL_PATH=./bge-small-zh-v1.5
# cross-encoder 重排模型目录；留空自动发现，无模型降级词面重排
BP_RERANK_MODEL=

# ── 稳定性护栏 ──────────────────────────────────────────
BP_LLM_TIMEOUT=60          # LLM 请求超时（秒），防网络卡死
BP_LLM_MAX_RETRIES=2       # LLM 调用重试次数（网关层显式重试，0=不重试）
BP_LLM_RETRY_BACKOFF=0.5   # LLM 重试基础退避秒数（按 2^n 指数增长）
BP_MAX_LOOP_DEPTH=12       # ReAct 最大循环深度（防无限轮次）
BP_MAX_SAME_CALL=2         # 相同(工具+参数)最大重复次数
BP_MAX_CONSEC_ERROR=2      # 连续失败阈值（超过注入策略调整提示）
BP_GRAPH_MAX_DEPTH=3       # 故障图谱多跳推演最大深度
BP_PARALLEL_WORKERS=4      # 并行工具执行线程数
RATE_LIMIT_RPM=60          # 每分钟每 IP 请求上限（0=关闭限流）

# ── 语义缓存 ────────────────────────────────────────────────────
BP_CACHE_TTL=600           # 缓存条目有效期（秒）
BP_CACHE_SIM=0.92          # 语义命中余弦相似度阈值
BP_CACHE_MAX=2000          # 最大缓存条目数（超出淘汰一半）

# ── 可观测性（observability.py） ────────────────────────────────
BP_LOG_LEVEL=INFO          # 日志级别（INFO/WARNING/...）
BP_LOG_FORMAT=json         # 日志格式：json（默认，供日志采集器解析）/ text（人读）

# ── 评估与基准 ──────────────────────────────────────────────────
# 评估指标后端：native（零依赖）/ ragas / trulens
BP_METRIC_BACKEND=native
# benchmark 脚本默认实现方式：manual / fc
BENCHMARK_MODE=fc
# 自定义免责声明文案（留空用内置标准版）
BP_DISCLAIMER=

# ═══ P4 平台安全与水平扩展 ═════════════════════════════════════

# ── API 鉴权（auth.py）──────────────────────────────────────────
# 业务 API Key，逗号分隔可配多个；与 BP_ADMIN_KEYS 都留空 = 本地开发模式不启用鉴权
BP_API_KEYS=
# 管理 Key（逗号分隔）：拥有管理端点权限（如清空缓存），同 Key 出现在两集合时以 admin 为准
BP_ADMIN_KEYS=
# 审计日志路径（管理操作 JSONL 留痕，默认 logs/audit.jsonl）
BP_AUDIT_PATH=

# ── LLM 网关备链路（llm_gateway.py，可选）───────────────────────
# 备链路 OpenAI 兼容端点（如 https://api.deepseek.com）；与 BP_LLM_FALLBACK_API_KEY 同时配置才启用
BP_LLM_FALLBACK_BASE_URL=
# 备链路 API Key
BP_LLM_FALLBACK_API_KEY=
# 备链路模型名（留空沿用主链路 AGENT_MODEL）
BP_LLM_FALLBACK_MODEL=

# ── 会话存储外置（conversation_store.py）────────────────────────
# Redis 连接串（如 redis://localhost:6379/0）：配置后多副本共享会话（水平扩展）；
# 未配置用进程内存；配置但连不上自动回落内存并告警
BP_REDIS_URL=
